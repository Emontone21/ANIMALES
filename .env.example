# Copiá este archivo a .env y completá los valores.
# Las variables con prefijo EXPO_PUBLIC_ se embeben en la app: nunca pongas secretos acá.

# URL y clave anónima (publishable) del proyecto Supabase.
# Dashboard > Project Settings > API. En Vercel van en Settings > Environment Variables.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Estilo de mapa (MapLibre style JSON). OpenFreeMap es gratis y no pide clave.
# Alternativas: https://tiles.openfreemap.org/styles/bright | /positron
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Google OAuth se configura en el dashboard de Supabase (Authentication > Providers),
# no acá. Redirect URI del cliente de Google: https://<ref>.supabase.co/auth/v1/callback
