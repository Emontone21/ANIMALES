# Copiá este archivo a .env y completá los valores.
# Las variables con prefijo EXPO_PUBLIC_ se embeben en la app: nunca pongas secretos acá.

# URL y clave pública del proyecto Supabase. En Vercel van en Settings > Environment Variables.
# La publishable (sb_publishable_…) está en Dashboard > Project Settings > API Keys.
# La anon (legacy, un JWT que empieza con eyJ) queda de respaldo mientras exista:
# Supabase la deja de aceptar a fin de 2026. Si están las dos, se usa la publishable.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Captcha de Cloudflare Turnstile al registrarse, ingresar y recuperar la contraseña: la
# clave del sitio del widget (pública). Sin ella, la app no muestra captcha. La clave
# secreta va solo en Supabase (Authentication > Attack Protection), nunca acá.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Notificaciones en el celular (Web Push): la clave VAPID pública (65 bytes en base64url),
# la misma que el secreto VAPID_PUBLIC_KEY de la función avisar. La privada va solo en la
# función (supabase secrets set), nunca acá. Sin esta clave, la app no ofrece notificaciones.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Estilo base del mapa (MapLibre style JSON). OpenFreeMap es gratis y no pide clave.
# La app lo recolorea con la paleta clara u oscura (src/components/mapa/estiloBase.ts);
# si el estilo no tiene las capas de OpenMapTiles, se usa tal cual.
# Alternativas: https://tiles.openfreemap.org/styles/liberty | /bright
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Sitio publicado: los links que se comparten son <sitio>/animal/<id>.
# Si no se completa, se usa https://spot-uy.vercel.app.
EXPO_PUBLIC_SITE_URL=https://spot-uy.vercel.app

# Google OAuth se configura en el dashboard de Supabase (Authentication > Providers),
# no acá. Redirect URI del cliente de Google: https://<ref>.supabase.co/auth/v1/callback
