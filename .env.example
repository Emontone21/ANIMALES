# Copiá este archivo a .env y completá los valores.
# Las variables con prefijo EXPO_PUBLIC_ se embeben en la app: nunca pongas secretos acá.

# URL y clave anónima (publishable) del proyecto Supabase.
# Dashboard > Project Settings > API. En Vercel van en Settings > Environment Variables.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Estilo base del mapa (MapLibre style JSON). OpenFreeMap es gratis y no pide clave.
# La app lo recolorea con la paleta clara u oscura (src/components/mapa/estiloBase.ts);
# si el estilo no tiene las capas de OpenMapTiles, se usa tal cual.
# Alternativas: https://tiles.openfreemap.org/styles/liberty | /bright
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Google OAuth se configura en el dashboard de Supabase (Authentication > Providers),
# no acá. Redirect URI del cliente de Google: https://<ref>.supabase.co/auth/v1/callback
