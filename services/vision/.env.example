# Variables del servicio de visión. En Cloud Run las carga desplegar.sh: las
# claves van en Secret Manager, nunca en git.
SUPABASE_URL=https://<ref>.supabase.co
# Clave service_role (Project Settings > API Keys > Legacy API Keys). Es secreta.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con Supabase (config_app.vision_secret). Cualquier string largo al azar.
VISION_SECRET=
# Opcionales.
# PORT=7860                    # Cloud Run pasa 8080
# HILOS=2                      # núcleos para torch (los vCPU del servicio)
# TIEMPO_MAXIMO_COLA_SEG=90    # tope de /procesar-pendientes
