# Variables del servicio de visión. En Hugging Face Spaces van en Settings > Variables and secrets.
SUPABASE_URL=https://<ref>.supabase.co
# Clave service_role (Project Settings > API). Es secreta: nunca va en la app ni en git.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con Supabase (config_app.vision_secret). Cualquier string largo al azar.
VISION_SECRET=
# Cada cuántos segundos revisar la cola por si se perdió algún webhook.
INTERVALO_COLA_SEG=300
