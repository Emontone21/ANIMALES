# Variables del servicio de visión. En Cloud Run las carga desplegar.sh: las
# claves van en Secret Manager, nunca en git.
SUPABASE_URL=https://<ref>.supabase.co
# Clave secreta (Settings > API Keys > "Publishable and secret API keys" > Secret keys,
# empieza con sb_secret_). Es la que se prefiere.
SUPABASE_SECRET_KEY=
# O, mientras exista, la legacy service_role (pestaña Legacy API Keys, empieza con eyJ).
# Si están las dos, se usa SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con Supabase (config_app.vision_secret). Cualquier string largo al azar.
VISION_SECRET=
# Opcionales.
# PORT=7860                    # Cloud Run pasa 8080
# HILOS=2                      # núcleos para torch (los vCPU del servicio)
# TIEMPO_MAXIMO_COLA_SEG=90    # tope de /procesar-pendientes
