  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "prebuild": "expo prebuild",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/tipos-db.js",
    "db:push": "npx supabase db push",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "postinstall": "node scripts/copiar-a-public.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/entorno.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
