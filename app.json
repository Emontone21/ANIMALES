{
  "expo": {
    "name": "Spot",
    "slug": "spot-mvd",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotmvd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uy.spotmvd.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "uy.spotmvd.app",
      "adaptiveIcon": {
        "backgroundColor": "#556B2F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#556B2F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spot usa tu ubicación para marcar dónde viste al animal y centrar el mapa cerca tuyo."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Spot usa la cámara para sacarle una foto al animal que encontraste.",
          "photosPermission": "Spot accede a tus fotos para que elijas una del animal que encontraste.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#556B2F",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
