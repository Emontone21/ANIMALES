# Variables del proyecto del Panel de SPOT en Vercel (Root Directory PANEL).
# Se cargan en Vercel → Settings → Environment Variables, solo en Production.
# Este archivo no lleva valores reales: es la lista de qué va y para qué.
#
# "Pública": puede llegar al navegador (api/config la devuelve, una por una).
# "Privada": solo la leen las funciones de api/; nunca llega al navegador.
# "Secreta": privada y además es una credencial. Marcala como Sensitive en Vercel.
#
# Nunca cargues la clave service_role ni la secret (sb_secret_…) de Supabase:
# el panel no la usa ni la va a usar, y si la ponés en SUPABASE_PUBLISHABLE_KEY
# la rechaza (no la manda al navegador).

# --- Ingreso y permisos (sin estas tres no se puede entrar) -------------------

# Pública. La URL del proyecto de Supabase de la app: https://<ref>.supabase.co
# De acá sale también el ref para los links al dashboard de Supabase.
SUPABASE_URL=

# Pública. La clave publishable (sb_publishable_…) de ese proyecto o, si no
# hay, la anon legacy. La misma que usa la app.
SUPABASE_PUBLISHABLE_KEY=

# Privada. Ids (uuid) de las cuentas que pueden entrar, separados por comas.
# Están en Supabase → Authentication → Users. Cualquier otra cuenta ve
# "Acceso denegado".
ADMIN_USER_IDS=

# --- Links "Abrir en…" (públicas: no son secretas) ----------------------------

# Pública. La dirección de la app (para "Abrir en la app"), por ejemplo
# https://<dominio-de-la-app>
LINK_APP_URL=

# Públicas. El equipo (slug) y el nombre del proyecto de Vercel de la app,
# como aparecen en https://vercel.com/<equipo>/<proyecto>. También las usa el
# prompt "Vercel y servicio de visión" para pedir los deploys.
LINK_VERCEL_TEAM=
LINK_VERCEL_PROJECT=

# Públicas. La página de cada red (https, del dominio de la red).
LINK_FACEBOOK_URL=
LINK_INSTAGRAM_URL=
LINK_LINKEDIN_URL=

# Pública. El Space del servicio de visión:
# https://huggingface.co/spaces/<dueño>/<nombre> (o su https://<…>.hf.space).
LINK_VISION_URL=

# --- Integraciones (las usan los prompts siguientes) --------------------------

# Secreta. Token de Vercel con alcance solo al equipo de la app y con
# vencimiento. Prompt "Vercel y servicio de visión".
VERCEL_API_TOKEN=

# Secreta. Token de página de Meta (de solo lectura: pages_read_engagement,
# read_insights, instagram_basic, instagram_manage_insights).
# Prompt "Facebook e Instagram".
META_ACCESS_TOKEN=

# Privadas. El id numérico de la página de Facebook y el de la cuenta
# profesional de Instagram.
META_PAGE_ID=
META_IG_USER_ID=

# Secreta. Token de la Community Management API de LinkedIn (dura 60 días).
# Prompt "LinkedIn".
LINKEDIN_ACCESS_TOKEN=

# Privada. El id numérico de la organización de LinkedIn.
LINKEDIN_ORG_ID=

# --- A futuro (DISEÑO.md, "Alertas"): todavía no las lee nada -----------------
# Secreta. Solo si el Space es privado.
# HF_TOKEN=
# Secretas. Para mandar alertas por Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Secreta. Vercel la manda en cada llamada de un cron job; la función la compara.
# CRON_SECRET=
